/*
 * Eyelash Sofle — ZMK keymap
 *
 * Layers:
 *   0 = BASE   Colemak-DH + home-row mods on both hands
 *   1 = NAV    Navigation / numpad / mouse buttons   (hold L-thumb SPACE)
 *   2 = SYM    Symbols                               (hold R-thumb BSPC or TAB)
 *   3 = CMK    QWERTY                                (toggle in via SYM + C)
 *   4 = SYMC   SYM while on QWERTY (C -> back to BASE)
 *   5 = FN     Function / media / BT / RGB / system  (tri-layer NAV+SYM)
 *
 * Thumb cluster (outer -> inner, 6 per side):
 *   L: MUTE | CTRL | GUI | ALT | ENTER/SYM | SYM (mo/sticky)
 *   R: ENTER | ESC | SPACE/NAV | TAB/SYM | RALT | DEL
 *
 * Home-row mods / holds (BASE Colemak-DH):
 *   L (mods):   A=Ctrl  R=Alt  S=GUI  T=Shift (hsl)   G=ESC (hla)
 *   R (arrows): M=UP     N=DOWN  E=LEFT  I=RIGHT  O=RShift   (tap = letter, hold = arrow/mod)
 *
 * Home-row mods / holds (CMK QWERTY) — same pattern:
 *   L (mods):   A=Ctrl  S=Alt  D=GUI  F=Shift (hsl)   G=ESC (hla)
 *   R (arrows): H=UP     J=DOWN  K=LEFT  L=RIGHT  ;=RShift
 *
 * Combos (DISABLED — kept in source for easy re-enable):
 *   J+K       -> ESC
 *   M+,       -> TAB
 *   C+V       -> Caps Word
 *   14+28+40  -> soft_off (power down)
 */

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/* Layer aliases (must match declaration order in keymap { } below).
 * Note: CMK/SYMC names are kept for compatibility but layer 3 is now QWERTY. */
#define BASE 0
#define NAV  1
#define SYM  2
#define CMK  3
#define SYMC 4
#define FN   5

/* ------------------------------------------------------------------
 * Pointing devices (trackball + scroll wheel) — kept from prior tuning.
 * ------------------------------------------------------------------ */
&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms  = <100>;
    delay-ms              = <0>;
};

&mmv {
    time-to-max-speed-ms  = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms     = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/* Caps-word continuation: let it survive common word separators. */
&caps_word { continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>; };

/* Sticky keys ignore other modifiers — allows sequential sticky stacking
 * (e.g. hold A=Ctrl, release, hold R=Alt, release, tap key → Ctrl+Alt+key). */
&sk { ignore-modifiers; };

/ {
    /* Tri-layer: holding NAV and SYM simultaneously activates FN. */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <FN>;
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    behaviors {
        /* Home-row mods (left hand) — Ctrl / Alt / GUI only (A / R / S).
         *
         *   Tap  = letter
         *   Hold + other key + release  = Ctrl/Alt/GUI + that key
         *   Hold + release alone        = sticky mod for the NEXT keypress only
         *
         * - balanced flavor is forgiving for fast typists
         * - require-prior-idle-ms prevents mods after rolling letters
         *   (kept strict at 150 — you press these deliberately, with a pause;
         *    SHIFT is split onto `hsl` below so fast-typing holds still register)
         * - hold-trigger-key-positions = only the OTHER hand
         * - hold-trigger-on-release keeps rolls from accidentally modding
         */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&sk>, <&kp>;
            hold-trigger-key-positions = <
                /* Full right hand */
                6  7  8  9  10 11 12
                19 20 21 22 23 24 25
                32 33 34 35 36 37 38
                45 46 47 48 49 50 51
                58 59 60 61 62 63
                /* Other left-hand HRM keys — A+R+S+T can chord together */
                27 28 29 30
            >;
            hold-trigger-on-release;
        };

        /* Left-hand SHIFT (T on Colemak, F on QWERTY) — same as hml but tuned
         * so a deliberate long-press registers even in the middle of a fast
         * burst. require-prior-idle-ms is removed (0) because Shift is the one
         * mod you fire mid-word to capitalize, so it must NOT be force-resolved
         * to a tap just because you pressed a key <150ms earlier.
         *
         * Roll protection is still provided by the opposite-hand positional
         * guard + hold-trigger-on-release (same-hand rolls won't shift).
         * If you ever get accidental capitals on fast opposite-hand rolls,
         * raise require-prior-idle-ms here to ~50.
         */
        hsl: home_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            bindings = <&sk>, <&kp>;
            hold-trigger-key-positions = <
                /* Full right hand */
                6  7  8  9  10 11 12
                19 20 21 22 23 24 25
                32 33 34 35 36 37 38
                45 46 47 48 49 50 51
                58 59 60 61 62 63
                /* Other left-hand HRM keys — can chord together */
                27 28 29 30
            >;
            hold-trigger-on-release;
        };

        /* Right-hand SHIFT (O on Colemak, ; on QWERTY).
         * This behavior is used ONLY for right-shift, so require-prior-idle-ms
         * is set to 0 here directly (same reasoning as hsl above). */
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            bindings = <&sk>, <&kp>;
            hold-trigger-key-positions = <
                0  1  2  3  4  5
                13 14 15 16 17 18
                26 27 28 29 30 31
                39 40 41 42 43 44
                52 53 54 55 56 57
            >;
            hold-trigger-on-release;
        };

        /* Right-hand home-row arrows: tap = letter, hold = arrow key.
         * Uses the same opposite-hand guard so fast right-hand rolls
         * ("jkl", "kl", "lk") do NOT fire an arrow — an arrow only fires
         * when the key is held while a key on the LEFT hand is involved,
         * or held long enough past the tapping term.
         */
        hra: home_row_arrow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0  1  2  3  4  5
                13 14 15 16 17 18
                26 27 28 29 30 31
                39 40 41 42 43 44
                52 53 54 55 56 57
            >;
            hold-trigger-on-release;
        };

        /* Left-hand hold-arrow: same as hra but triggers on RIGHT hand.
         * Used for G=ESC (left inner column, needs right-hand pairing).
         * Used ONLY by G, so require-prior-idle-ms is set to 0 directly so a
         * long-press reliably yields Esc during fast typing.
         */
        hla: home_left_arrow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                6  7  8  9  10 11 12
                19 20 21 22 23 24 25
                32 33 34 35 36 37 38
                45 46 47 48 49 50 51
                58 59 60 61 62 63
            >;
            hold-trigger-on-release;
        };

        /* Layer-tap tuned for thumbs: snappier hold. */
        lt_thumb: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        /* "Smart" layer thumb:
         *   hold = momentary layer (&mo)
         *   tap  = sticky one-shot layer (&sl)
         *
         * Usage: &ltq <layer> <layer>    (same layer twice)
         *
         * Behavior:
         *   - Press and hold → layer is active while held, releases when you let go
         *     (standard momentary).
         *   - Quick press and release (< tapping-term-ms) with NO other key pressed
         *     → layer is sticky: the very next keypress is interpreted on that layer,
         *     then the layer auto-releases.
         *   - Press, then press another key before releasing → acts as momentary
         *     (the held-down layer is what the other key lands on).
         *
         * "balanced" flavor + quick-tap-ms=0 so consecutive taps feel predictable.
         */
        ltq: layer_tap_or_sticky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&sl>;
        };

        /* Tap = kp, Hold = sticky layer.
         *
         *   Usage: &kp_slh <layer> <keycode>
         *
         *   - Quick tap and release               → kp (e.g. ENTER)
         *   - Hold past tapping term, press key   → that key lands on <layer>
         *     (feels like a momentary layer — sticky fires first, next key uses it)
         *   - Hold past tapping term, release     → <layer> is sticky for the next
         *     keypress; then auto-releases.
         *
         *   'balanced' + require-prior-idle-ms keep it from firing as a sticky layer
         *   during fast typing.
         */
        kp_slh: kp_tap_sticky_layer_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <120>;
            require-prior-idle-ms = <100>;
            bindings = <&sl>, <&kp>;
        };
    };

/*
*    combos {
*        compatible = "zmk,combos";
*
*        combo_softoff {
*            bindings = <&soft_off>;
*            key-positions = <14 28 40>;
*            layers = <BASE CMK>;
*        };
*
*        combo_esc {
*            bindings = <&kp ESC>;
*            key-positions = <20 21>;   // J + K
*            timeout-ms = <40>;
*            layers = <BASE CMK>;
*        };
*
*        combo_tab {
*            bindings = <&kp TAB>;
*            key-positions = <34 35>;   // M + ,
*            timeout-ms = <40>;
*            layers = <BASE CMK>;
*        };
*
*        combo_caps_word {
*            bindings = <&caps_word>;
*            key-positions = <29 30>;   // C + V
*            timeout-ms = <40>;
*            layers = <BASE CMK>;
*        };
*    };
*/

    keymap {
        compatible = "zmk,keymap";

        /* ==================================================================
         * LAYER 0 — BASE (Colemak-DH)
         * ================================================================== */
        base_layer {
            display-name = "BASE";
            bindings = <
&kp ESC        &kp N1         &kp N2         &kp N3        &kp N4              &kp N5            &kp UP_ARROW      &kp N6              &kp N7         &kp N8        &kp N9         &kp N0            &mt CAPS BSPC
&kp TAB        &kp Q          &kp W          &kp F         &kp P               &kp B             &kp DOWN_ARROW    &kp J               &kp L          &kp U         &kp Y          &kp SEMI          &kp BSLH
&kp BACKSPACE  &hml LCTRL A   &hml LALT R   &hml LGUI S   &hsl LSHFT T         &hla ESC G        &kp LEFT_ARROW    &hra UP M           &hra DOWN N    &hra LEFT E   &hra RIGHT I   &hmr RSHFT O      &kp APOS
&sk LSHFT      &kp X          &kp C          &kp D         &kp V               &kp Z             &kp RIGHT_ARROW   &kp K               &kp H          &kp COMMA     &kp DOT        &kp FSLH          &sk RSHFT
&kp C_MUTE     &kp LCTRL      &kp LGUI       &kp LALT      &kp_slh SYM ENTER   &ltq SYM SYM      &kp ENTER         &kp ESC   &kp_slh NAV SPACE        &lt_thumb SYM TAB  &kp RALT  &kp DEL
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        /* ==================================================================
         * LAYER 1 — NAV / NUM
         *   Left hand: mouse buttons + left-hand mirror of mods for chords.
         *   Right hand: arrow cluster + numpad.
         * ================================================================== */
        nav_layer {
            display-name = "NAV";
            bindings = <
&trans     &kp F1      &kp F2      &kp F3      &kp F4      &kp F5          &mmv MOVE_UP     &kp F6      &kp F7     &kp F8     &kp F9     &kp F10     &kp F11
&trans     &kp ESC     &mkp LCLK   &mkp MCLK   &mkp RCLK   &mkp MB4        &mmv MOVE_DOWN   &kp PG_UP   &kp N7     &kp N8     &kp N9     &kp MINUS   &kp F12
&trans     &kp LCTRL   &kp LALT    &kp LGUI    &kp LSHFT   &mkp MB5        &mmv MOVE_LEFT   &kp HOME    &kp N4     &kp N5     &kp N6     &kp PLUS    &kp EQUAL
&trans     &kp K_UNDO  &kp K_CUT   &kp K_COPY  &kp K_PASTE &kp K_REDO      &mmv MOVE_RIGHT  &kp END     &kp N1     &kp N2     &kp N3     &kp ASTRK   &trans
&trans     &trans      &trans      &trans      &trans      &trans          &mkp LCLK        &kp N0      &kp DOT    &kp COMMA  &trans     &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        /* ==================================================================
         * LAYER 2 — SYM
         *   Right hand holds the heavy symbol content.
         *   Left-hand home row mirrors mods so Shift/Ctrl+symbol chords work.
         *   Position 42 (left hand `C`) -> `&to CMK` toggles to QWERTY.
         * ================================================================== */
        sym_layer {
            display-name = "SYM";
            bindings = <
&trans     &kp F1      &kp F2      &kp F3      &kp F4      &kp F5          &mmv MOVE_UP     &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &trans
&kp TILDE  &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT       &mmv MOVE_DOWN   &kp CARET    &kp AMPS     &kp ASTRK    &kp LPAR     &kp RPAR     &kp COLON 
&kp GRAVE  &kp LCTRL   &kp LALT    &kp LGUI    &kp LSHFT   &kp DQT         &mmv MOVE_LEFT   &kp PLUS    &kp EQUAL    &kp LBRC     &kp RBRC     &kp MINUS    &kp SEMI
&trans     &kp UNDER   &kp LT      &to CMK     &kp GT      &kp BSLH        &mmv MOVE_RIGHT  &kp SLASH    &kp QMARK    &kp LBKT     &kp RBKT     &kp UNDER    &trans
&trans     &trans      &trans      &trans      &trans      &trans          &mkp LCLK        &trans       &trans       &trans       &trans       &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        /* ==================================================================
         * LAYER 3 — QWERTY (toggle via SYM + C)
         *   Thumb cluster uses SYMC so that `C` returns to BASE (Colemak-DH).
         * ================================================================== */
        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC    &kp N1         &kp N2        &kp N3         &kp N4              &kp N5            &kp UP_ARROW      &kp N6              &kp N7         &kp N8        &kp N9         &kp N0            &mt CAPS BSPC
&kp TAB    &kp Q          &kp W         &kp E          &kp R               &kp T             &kp DOWN_ARROW    &kp Y               &kp U          &kp I         &kp O          &kp P             &kp BSLH
&kp BACKSPACE  &hml LCTRL A   &hml LALT S   &hml LGUI D   &hsl LSHFT F  &hla ESC G        &kp LEFT_ARROW    &hra UP H          &hra DOWN J      &hra LEFT K   &hra RIGHT L    &hmr RSHFT SEMI   &kp APOS
&sk LSHFT  &kp Z          &kp X         &kp C          &kp V               &kp B             &kp RIGHT_ARROW   &kp N               &kp M          &kp COMMA     &kp DOT        &kp FSLH          &sk RSHFT
&kp C_MUTE &kp LCTRL      &kp LGUI      &kp LALT       &kp_slh SYMC ENTER  &ltq SYMC SYMC    &kp ENTER         &kp ESC   &kp_slh NAV SPACE        &lt_thumb SYMC TAB  &kp RALT  &kp DEL
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        /* ==================================================================
         * LAYER 4 — SYMC (SYM while in QWERTY)
         *   Identical to SYM, but the "C" slot at position 42 sends `&to BASE`
         *   to flip back to Colemak-DH.
         * ================================================================== */
        sym_cmk_layer {
            display-name = "SYM-C";
            bindings = <
&trans     &kp F1      &kp F2      &kp F3      &kp F4      &kp F5          &mmv MOVE_UP     &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &trans
&kp TILDE  &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT       &mmv MOVE_DOWN   &kp CARET    &kp AMPS     &kp ASTRK    &kp LPAR     &kp RPAR     &kp COLON
&kp GRAVE  &kp LCTRL   &kp LALT    &kp LGUI    &kp LSHFT   &kp DQT         &mmv MOVE_LEFT   &kp PLUS     &kp EQUAL    &kp LBRC     &kp RBRC     &kp MINUS    &kp SEMI
&trans     &kp UNDER   &kp LT      &to BASE    &kp GT      &kp BSLH        &mmv MOVE_RIGHT  &kp SLASH    &kp QMARK    &kp LBKT     &kp RBKT     &kp UNDER    &trans
&trans     &trans      &trans      &trans      &trans      &trans          &mkp LCLK        &trans       &trans       &trans       &trans       &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        /* ==================================================================
         * LAYER 5 — FN / Media / System / BT   (tri-layer NAV+SYM)
         *   All the "rare" stuff: bluetooth, RGB, resets, output toggle,
         *   media controls.
         * ================================================================== */
        fn_layer {
            display-name = "FN/SYS";
            bindings = <
&bt BT_CLR &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4      &mmv MOVE_UP     &kp C_BRI_UP  &kp C_BRI_DN  &trans       &trans  &trans  &trans
&trans     &out OUT_TOG     &out OUT_USB      &out OUT_BLE     &bt BT_CLR_ALL   &trans            &mmv MOVE_DOWN   &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP &kp C_NEXT &trans &trans
&trans     &rgb_ug RGB_TOG  &rgb_ug RGB_EFF   &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD   &mmv MOVE_LEFT   &kp C_PP      &kp C_MUTE    &kp C_STOP   &trans  &trans  &trans
&trans     &rgb_ug RGB_OFF  &rgb_ug RGB_ON    &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &trans            &mmv MOVE_RIGHT  &sys_reset    &bootloader   &soft_off    &trans  &trans  &trans
&trans     &trans           &trans            &trans           &trans           &trans            &mkp LCLK        &trans        &trans        &trans       &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
